# =============================================================================
# KAPWA Hospitality OS — Standalone Environment Configuration
# =============================================================================

# Neon PostgreSQL Connection String (Leave blank to use embedded local store)
DATABASE_URL=

# Frontend -> KAPWA Backend API URL (Leave blank to use relative /api proxy)
VITE_KAPWA_API_URL=

# Staff JWT Enforcement ("auto" | "true" | "false")
VITE_ENFORCE_STAFF_JWT=auto

# Server-Side Staff JWT & Internal Function Secrets
STAFF_JWT_SECRET=kapwa-standalone-jwt-secret-change-in-production-2026
INTERNAL_FN_SECRET=kapwa-internal-fn-secret-dev

# Backend Server Host & Port
HOST=0.0.0.0
PORT=3000
