# Frontend env vars (Vite). Copy to .env and fill in for YOUR Supabase project.
VITE_SUPABASE_PROJECT_ID="your-new-project-ref"
VITE_SUPABASE_URL="https://your-new-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-new-anon-key"

# Claim-based auth. One of "auto" | "true" | "false".
#   auto  (default, recommended) — attach the staff JWT to database requests
#         only after PostgREST has been observed to accept it. A mismatched
#         STAFF_JWT_SECRET degrades to anonymous access and is reported in
#         Admin → Diagnostics, instead of 401-ing every request in the app.
#   true  — always attach. Only set this once Diagnostics reports "active".
#   false — never attach; staff run as the anonymous role.
# See src/lib/staffAuth.ts and docs/security/rls-migration.md
VITE_USE_STAFF_JWT="auto"

# ─────────────────────────────────────────────────────────────────────────────
# Edge-function secrets (set in Supabase, NOT here — listed for reference):
#   INTERNAL_FN_SECRET   - guards admin-summary / guest-requests-api / telegram (set in Supabase secrets, NOT here)
#   STAFF_JWT_SECRET     - = your project's JWT secret (Settings -> API)
#   OPENROUTER_API_KEY   - AI functions (concierge-ai, ops-coordinator, ...)
#   LOVABLE_API_KEY      - AI gateway function(s)
#   TELEGRAM_BOT_TOKEN   - send-telegram
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase.
