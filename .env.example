# =============================================================================
# KAPWA Hospitality OS — Environment Configuration (Standalone / Neon PostgreSQL)
# =============================================================================
# Copy this file to `.env` for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# 1. Neon PostgreSQL Database
# -----------------------------------------------------------------------------
# Neon pooled/direct PostgreSQL connection string:
#   postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
# Run `npm run db:migrate` to apply `db/schema.sql` and `db/permissions.sql`.
# When left blank in local dev, KAPWA OS runs against its embedded JSON store.
DATABASE_URL="postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# 2. Frontend (Vite) — exposed to browser (`VITE_` prefix)
# -----------------------------------------------------------------------------
# Base URL of the KAPWA Express backend (leave empty in dev to use Vite `/api` proxy)
VITE_KAPWA_API_URL=""

# Staff JWT cutover control ("false" | "auto" | "true")
VITE_ENFORCE_STAFF_JWT="auto"

# -----------------------------------------------------------------------------
# 3. Backend Server & Security Secrets (`server/index.js`)
# -----------------------------------------------------------------------------
HOST="0.0.0.0"
PORT="3000"

# 32+ byte random secret used by `employee-auth` to sign and verify HS256 staff JWTs.
# Generate with: `openssl rand -hex 32`
STAFF_JWT_SECRET=""

# Shared secret for internal service-to-service calls (`x-internal-secret` header).
# Generate with: `openssl rand -hex 32`
INTERNAL_FN_SECRET=""

# Enforce strict server-side RBAC on all table mutations ("true" | "false")
KAPWA_STRICT_PERMISSIONS="false"

# Optional custom storage directory for receipts, logos, and guest documents
KAPWA_STORAGE_DIR=""

# -----------------------------------------------------------------------------
# 4. AI Model Gateway & Messaging Integrations
# -----------------------------------------------------------------------------
# OpenRouter API key for TALA Guest Concierge, Resort Operator, Ops Coordinator,
# and Receipt OCR Vision (can also be configured in Admin -> Agent Settings).
OPENROUTER_API_KEY=""
GUEST_MODEL="openai/gpt-4o-mini"
OPERATOR_MODEL="anthropic/claude-haiku-4-5"
OPS_COORDINATOR_MODEL="anthropic/claude-haiku-4-5"
OCR_VISION_MODEL="google/gemini-2.5-flash"

# Telegram Bot notifications (`send-telegram`)
TELEGRAM_BOT_TOKEN=""

# Optional WhatsApp bridge (`guest-whatsapp`)
WHATSAPP_BRIDGE_URL=""
WHATSAPP_BRIDGE_SECRET=""
