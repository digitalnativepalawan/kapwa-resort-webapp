# ── LiveKit (self-hosted) ───────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_minimum_32_chars

# ── Ollama ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── whisper.cpp (STT, OpenAI-compatible server) ────────────────────────
WHISPER_BASE_URL=http://localhost:9000

# ── Kokoro (TTS, Kokoro-FastAPI, OpenAI-compatible server) ─────────────
KOKORO_BASE_URL=http://localhost:8880
KOKORO_VOICE=af_bella

# ── KAPWA Backend / Neon PostgreSQL ─────────────────────────────────────
KAPWA_API_URL=http://127.0.0.1:3000
INTERNAL_FN_SECRET=replace_with_real_internal_fn_secret_never_commit
DATABASE_URL=

# ── Weather (OpenWeatherMap free tier) ─────────────────────────────────
WEATHER_API_KEY=
RESORT_LAT=10.5333
RESORT_LON=119.2500

# ── Loop tuning ─────────────────────────────────────────────────────────
MAX_RETRIES=3
TOOL_TIMEOUT_SECONDS=8.0
