# Frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AGENT_RUNTIME_URL=http://127.0.0.1:3000/api
VITE_HERMES_URL=http://127.0.0.1:3000/api/hermes

# Local KAPWA agent server
PORT=3000
KAPWA_APP_URL=http://localhost:5173
KAPWA_ADMIN_TOKEN=

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KAPWA_SETTINGS_ENCRYPTION_KEY=
KAPWA_AGENT_SETTINGS_PATH=server/data/agent-settings.json

# Supabase service role key + internal secret for resort-operator edge function calls
# (needed for the server-side agent runtime to read Supabase state and execute actions)
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_FN_SECRET=

# Optional defaults. Admin settings override these after saving.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OPENROUTER_MODEL=openai/gpt-4o-mini
